# PostgreSQL connection string; use a dedicated user and database.
DATABASE_URL=postgresql+psycopg://bestin:bestin@localhost:5432/bestin
# Allow development startup with data/bestin.db if PostgreSQL is unreachable.
DB_FALLBACK_SQLITE=true
# Local file storage root and maximum book size in MiB.
STORAGE_DIR=data/storage
MAX_UPLOAD_MB=50
# Generate a long random secret locally, e.g. python -c 'import secrets; print(secrets.token_urlsafe(32))'.
JWT_SECRET=change-this-development-secret
JWT_EXPIRE_MINUTES=1440
# Created once when the email is absent; change these before deployment.
ADMIN_EMAIL=admin@bestin.local
ADMIN_PASSWORD=admin12345
# Internal AI service URL and shared secret; configure the same token in bestin-ai.
AI_URL=http://localhost:8001
AI_INTERNAL_TOKEN=dev-internal-token
AI_TIMEOUT=30
STATUS_POLL_SECONDS=5
# Comma-separated browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
